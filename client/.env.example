# Database
# MongoDB connection string used by the app (lib/db.ts). Required.
MONGODB_URI=mongodb://127.0.0.1:27017/university_super_app

# Auth (NextAuth v5)
# Secret used to sign session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
# Public base URL of the app.
AUTH_URL=http://localhost:3000
# Set to true when running behind a proxy / non-Vercel host.
AUTH_TRUST_HOST=true

# Optional: public app URL used for links and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000
